{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MRSIAVASSHIRBOT/MR_SIAVASH_AI/main/schemas/workspace-backup.schema.json",
  "title": "MR_SIAVASH_AI Workspace Backup",
  "description": "Version 1 browser-local workspace backup contract. Import regenerates task IDs and merges unique task text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "tasks"
  ],
  "properties": {
    "schema": {
      "const": "mr-siavash-ai-workspace"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "maxLength": 40
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "favorites": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,64}$"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "done"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  }
}
